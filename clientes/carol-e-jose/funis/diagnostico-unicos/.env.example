# Copie para .env.local (dev) e configure no painel da Netlify (produção).
# NADA aqui vai para o Git. Sem esses valores, o funil roda mas não publica leads
# nem redireciona para agendamento/comunidade reais.

# Endpoint que grava o lead na planilha (Make webhook ou Web App do Apps Script)
VITE_LEADS_ENDPOINT=

# WhatsApp destino, só dígitos com DDI. Ex.: 5551999999999
VITE_WHATSAPP=

# Link do Calendário nativo do GHL para agendamento (aprovados)
VITE_AGENDAMENTO_URL=

# Link da comunidade / Jornada 1 (desqualificados por papel ou porte)
VITE_COMUNIDADE_URL=

# Opcional: sobrescreve o container GTM (default GTM-T9XG58XR)
VITE_GTM_ID=
