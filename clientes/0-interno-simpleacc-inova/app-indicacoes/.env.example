# Banco Postgres. Na Vercel, criar em Storage → Create Database → Neon
# e usar "Connect Project": a variável é injetada automaticamente.
# Também aceita POSTGRES_URL, e funciona com qualquer Postgres (Supabase, Railway…).
DATABASE_URL=

# Senha compartilhada de acesso ao app (só o time usa).
# Se ficar vazia, o app abre sem pedir senha.
APP_SENHA=
